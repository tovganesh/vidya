generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum BoardType {
  CBSE
  ICSE
  STATE_BOARD
  IB
  CAMBRIDGE
  OTHER
}

enum AcademicYearStatus {
  PLANNING
  ACTIVE
  CONCLUDED
  ARCHIVED
}

enum AcademicStage {
  PRE_PRIMARY
  PRIMARY
  MIDDLE
  SECONDARY
  HIGHER_SECONDARY
}

enum SubjectType {
  THEORY
  PRACTICAL
  CO_SCHOLASTIC
  VOCATIONAL
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  TEACHER
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_MANAGER
  HR_MANAGER
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum StudentCategory {
  GENERAL
  OBC
  SC
  ST
  EWS
}

enum StudentStatus {
  ENROLLED
  ALUMNI
  TRANSFERRED
  WITHDRAWN
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  RETAINED
  TRANSFERRED_OUT
  DROPPED
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// ============================================================================
// Multi-Tenancy & School Hierarchy
// ============================================================================

model Organization {
  id                 String   @id @default(uuid())
  name               String
  registrationNumber String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  schools School[]

  @@map("organizations")
}

model School {
  id                 String     @id @default(uuid())
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name               String
  code               String     @unique
  board              BoardType  @default(CBSE)
  affiliationNumber  String?
  email              String?
  phone              String?
  address            Json?
  currency           String     @default("INR")
  settings           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  campuses      Campus[]
  academicYears AcademicYear[]
  classes       Class[]
  sections      Section[]
  subjects      Subject[]
  users         User[]
  students      Student[]
  guardians     Guardian[]
  teachers      Teacher[]
  enrollments   Enrollment[]
  auditLogs     AuditLog[]
  attendanceRecords AttendanceRecord[]
  periods       Period[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]

  @@map("schools")
}

model Campus {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  address   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("campuses")
}

// ============================================================================
// Academic Calendar & Structure
// ============================================================================

model AcademicYear {
  id        String             @id @default(uuid())
  schoolId  String
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(PLANNING)
  isCurrent Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  enrollments Enrollment[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@index([schoolId, status])
  @@map("academic_years")
}

model Class {
  id         String        @id @default(uuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  code       String
  stage      AcademicStage @default(SECONDARY)
  orderIndex Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  sections      Section[]
  classSubjects ClassSubject[]
  enrollments   Enrollment[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]

  @@unique([schoolId, code])
  @@index([schoolId, orderIndex])
  @@map("classes")
}

model Section {
  id         String   @id @default(uuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name       String
  roomNumber String?
  capacity   Int      @default(40)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]

  @@unique([classId, name])
  @@index([schoolId])
  @@map("sections")
}

model Subject {
  id        String      @id @default(uuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  type      SubjectType @default(THEORY)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  classSubjects ClassSubject[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

model ClassSubject {
  id            String   @id @default(uuid())
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  isCompulsory  Boolean  @default(true)
  weeklyPeriods Int      @default(5)
  createdAt     DateTime @default(now())

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// ============================================================================
// Identity, Access & RBAC
// ============================================================================

model User {
  id            String     @id @default(uuid())
  schoolId      String?
  school        School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email         String     @unique
  phone         String?
  passwordHash  String
  firstName     String
  lastName      String
  primaryRole   UserRole   @default(TEACHER)
  status        UserStatus @default(ACTIVE)
  isTotpEnabled Boolean    @default(false)
  totpSecret    String?
  backupCodes   Json?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles         UserRoleAssignment[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  student       Student?
  guardian      Guardian?
  teacher       Teacher?
  recordedAttendance AttendanceRecord[]

  @@index([schoolId, primaryRole])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

// ============================================================================
// Audit Logging
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  diff       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// People: Students, Guardians, Teachers & Academic Enrollments
// ============================================================================

model Student {
  id               String          @id @default(uuid())
  schoolId         String
  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId           String?         @unique
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionNumber  String
  admissionDate    DateTime        @default(now())
  firstName        String
  middleName       String?
  lastName         String
  gender           Gender
  dateOfBirth      DateTime
  bloodGroup       BloodGroup      @default(UNKNOWN)
  apaarId          String?
  aadhaarLastFour  String?
  nationality      String          @default("Indian")
  religion         String?
  category         StudentCategory @default(GENERAL)
  permanentAddress Json?
  currentAddress   Json?
  photoUrl         String?
  status           StudentStatus   @default(ENROLLED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  guardians   StudentGuardian[]
  enrollments Enrollment[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status])
  @@index([schoolId, firstName, lastName])
  @@map("students")
}

model Guardian {
  id           String               @id @default(uuid())
  schoolId     String
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String?              @unique
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  relationship GuardianRelationship @default(GUARDIAN)
  phone        String
  email        String?
  occupation   String?
  annualIncome String?
  address      Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  students StudentGuardian[]

  @@index([schoolId, phone])
  @@map("guardians")
}

model StudentGuardian {
  id                    String   @id @default(uuid())
  studentId             String
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId            String
  guardian              Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  isPrimaryContact      Boolean  @default(false)
  isAuthorizedPickup    Boolean  @default(false)
  receivesNotifications Boolean  @default(true)
  createdAt             DateTime @default(now())

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Teacher {
  id             String        @id @default(uuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode   String
  firstName      String
  lastName       String
  qualification  String?
  specialization String?
  phone          String?
  joiningDate    DateTime      @default(now())
  status         TeacherStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  timetableSlots TimetableSlot[]
  allocations    TeacherAllocation[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId, status])
  @@map("teachers")
}

model Enrollment {
  id             String           @id @default(uuid())
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rollNumber     Int?
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attendanceRecords AttendanceRecord[]

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, classId, sectionId])
  @@index([studentId])
  @@map("enrollments")
}

// ============================================================================
// Operations: Daily Attendance, Timetables & Staff Allocations
// ============================================================================

model AttendanceRecord {
  id           String           @id @default(uuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  remarks      String?
  recordedById String?
  recordedBy   User?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([enrollmentId, date])
  @@index([schoolId, date])
  @@map("attendance_records")
}

model Period {
  id           String          @id @default(uuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  periodNumber Int
  startTime    String
  endTime      String
  isBreak      Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  timetableSlots TimetableSlot[]

  @@unique([schoolId, periodNumber])
  @@index([schoolId])
  @@map("periods")
}

model TimetableSlot {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dayOfWeek      DayOfWeek
  periodId       String
  period         Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId      String?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomNumber     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([sectionId, academicYearId, dayOfWeek, periodId])
  @@index([schoolId, academicYearId, dayOfWeek])
  @@index([teacherId, academicYearId, dayOfWeek, periodId])
  @@map("timetable_slots")
}

model TeacherAllocation {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  isClassTeacher Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([schoolId, academicYearId])
  @@index([teacherId, academicYearId])
  @@index([sectionId, academicYearId])
  @@map("teacher_allocations")
}

