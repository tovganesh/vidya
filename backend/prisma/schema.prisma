generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums
// ============================================================================

enum BoardType {
  CBSE
  ICSE
  STATE_BOARD
  IB
  CAMBRIDGE
  OTHER
}

enum AcademicYearStatus {
  PLANNING
  ACTIVE
  CONCLUDED
  ARCHIVED
}

enum AcademicStage {
  PRE_PRIMARY
  PRIMARY
  MIDDLE
  SECONDARY
  HIGHER_SECONDARY
}

enum SubjectType {
  THEORY
  PRACTICAL
  CO_SCHOLASTIC
  VOCATIONAL
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  VICE_PRINCIPAL
  TEACHER
  ACCOUNTANT
  LIBRARIAN
  TRANSPORT_MANAGER
  HR_MANAGER
  PARENT
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum StudentCategory {
  GENERAL
  OBC
  SC
  ST
  EWS
}

enum StudentStatus {
  ENROLLED
  ALUMNI
  TRANSFERRED
  WITHDRAWN
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
}

enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  RETAINED
  TRANSFERRED_OUT
  DROPPED
}

enum TeacherStatus {
  ACTIVE
  ON_LEAVE
  RESIGNED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum ExamTermType {
  TERM_1
  TERM_2
  UNIT_TEST_1
  UNIT_TEST_2
  PRE_BOARD
  ANNUAL
}

enum AssessmentType {
  THEORY
  PRACTICAL
  INTERNAL_ASSESSMENT
  PROJECT
  ORAL
}

// ============================================================================
// Multi-Tenancy & School Hierarchy
// ============================================================================

model Organization {
  id                 String   @id @default(uuid())
  name               String
  registrationNumber String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  schools School[]

  @@map("organizations")
}

model School {
  id                 String     @id @default(uuid())
  organizationId     String?
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name               String
  code               String     @unique
  board              BoardType  @default(CBSE)
  affiliationNumber  String?
  email              String?
  phone              String?
  address            Json?
  currency           String     @default("INR")
  settings           Json?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  campuses      Campus[]
  academicYears AcademicYear[]
  classes       Class[]
  sections      Section[]
  subjects      Subject[]
  users         User[]
  students      Student[]
  guardians     Guardian[]
  teachers      Teacher[]
  enrollments   Enrollment[]
  auditLogs     AuditLog[]
  attendanceRecords AttendanceRecord[]
  periods       Period[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]
  announcements Announcement[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  examTerms     ExamTerm[]
  exams         Exam[]
  gradingScales GradingScale[]

  @@map("schools")
}

model Campus {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  address   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("campuses")
}

// ============================================================================
// Academic Calendar & Structure
// ============================================================================

model AcademicYear {
  id        String             @id @default(uuid())
  schoolId  String
  school    School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  status    AcademicYearStatus @default(PLANNING)
  isCurrent Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  enrollments Enrollment[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]
  examTerms   ExamTerm[]

  @@unique([schoolId, name])
  @@index([schoolId, isCurrent])
  @@index([schoolId, status])
  @@map("academic_years")
}

model Class {
  id         String        @id @default(uuid())
  schoolId   String
  school     School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  code       String
  stage      AcademicStage @default(SECONDARY)
  orderIndex Int
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  sections      Section[]
  classSubjects ClassSubject[]
  enrollments   Enrollment[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]
  exams         Exam[]

  @@unique([schoolId, code])
  @@index([schoolId, orderIndex])
  @@map("classes")
}

model Section {
  id         String   @id @default(uuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name       String
  roomNumber String?
  capacity   Int      @default(40)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  enrollments Enrollment[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]

  @@unique([classId, name])
  @@index([schoolId])
  @@map("sections")
}

model Subject {
  id        String      @id @default(uuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  code      String
  type      SubjectType @default(THEORY)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  classSubjects ClassSubject[]
  timetableSlots TimetableSlot[]
  teacherAllocations TeacherAllocation[]
  assessments   Assessment[]

  @@unique([schoolId, code])
  @@index([schoolId])
  @@map("subjects")
}

model ClassSubject {
  id            String   @id @default(uuid())
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  isCompulsory  Boolean  @default(true)
  weeklyPeriods Int      @default(5)
  createdAt     DateTime @default(now())

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

// ============================================================================
// Identity, Access & RBAC
// ============================================================================

model User {
  id            String     @id @default(uuid())
  schoolId      String?
  school        School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  email         String     @unique
  phone         String?
  passwordHash  String
  firstName     String
  lastName      String
  primaryRole   UserRole   @default(TEACHER)
  status        UserStatus @default(ACTIVE)
  isTotpEnabled Boolean    @default(false)
  totpSecret    String?
  backupCodes   Json?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  roles         UserRoleAssignment[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  student       Student?
  guardian      Guardian?
  teacher       Teacher?
  recordedAttendance AttendanceRecord[]
  authoredAnnouncements Announcement[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  enteredMarks  MarksRecord[]

  @@index([schoolId, primaryRole])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

// ============================================================================
// Audit Logging
// ============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  diff       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ============================================================================
// People: Students, Guardians, Teachers & Academic Enrollments
// ============================================================================

model Student {
  id               String          @id @default(uuid())
  schoolId         String
  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId           String?         @unique
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  admissionNumber  String
  admissionDate    DateTime        @default(now())
  firstName        String
  middleName       String?
  lastName         String
  gender           Gender
  dateOfBirth      DateTime
  bloodGroup       BloodGroup      @default(UNKNOWN)
  apaarId          String?
  aadhaarLastFour  String?
  nationality      String          @default("Indian")
  religion         String?
  category         StudentCategory @default(GENERAL)
  permanentAddress Json?
  currentAddress   Json?
  photoUrl         String?
  status           StudentStatus   @default(ENROLLED)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  guardians   StudentGuardian[]
  enrollments Enrollment[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId, status])
  @@index([schoolId, firstName, lastName])
  @@map("students")
}

model Guardian {
  id           String               @id @default(uuid())
  schoolId     String
  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId       String?              @unique
  user         User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  relationship GuardianRelationship @default(GUARDIAN)
  phone        String
  email        String?
  occupation   String?
  annualIncome String?
  address      Json?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  students StudentGuardian[]

  @@index([schoolId, phone])
  @@map("guardians")
}

model StudentGuardian {
  id                    String   @id @default(uuid())
  studentId             String
  student               Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId            String
  guardian              Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  isPrimaryContact      Boolean  @default(false)
  isAuthorizedPickup    Boolean  @default(false)
  receivesNotifications Boolean  @default(true)
  createdAt             DateTime @default(now())

  @@unique([studentId, guardianId])
  @@index([studentId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Teacher {
  id             String        @id @default(uuid())
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode   String
  firstName      String
  lastName       String
  qualification  String?
  specialization String?
  phone          String?
  joiningDate    DateTime      @default(now())
  status         TeacherStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  timetableSlots TimetableSlot[]
  allocations    TeacherAllocation[]

  @@unique([schoolId, employeeCode])
  @@index([schoolId, status])
  @@map("teachers")
}

model Enrollment {
  id             String           @id @default(uuid())
  schoolId       String
  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String
  class          Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  rollNumber     Int?
  enrollmentDate DateTime         @default(now())
  status         EnrollmentStatus @default(ACTIVE)
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  attendanceRecords AttendanceRecord[]
  marksRecords      MarksRecord[]

  @@unique([studentId, academicYearId])
  @@index([schoolId, academicYearId, classId, sectionId])
  @@index([studentId])
  @@map("enrollments")
}

// ============================================================================
// Operations: Daily Attendance, Timetables & Staff Allocations
// ============================================================================

model AttendanceRecord {
  id           String           @id @default(uuid())
  schoolId     String
  school       School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  remarks      String?
  recordedById String?
  recordedBy   User?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  recordedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([enrollmentId, date])
  @@index([schoolId, date])
  @@map("attendance_records")
}

model Period {
  id           String          @id @default(uuid())
  schoolId     String
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name         String
  periodNumber Int
  startTime    String
  endTime      String
  isBreak      Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  timetableSlots TimetableSlot[]

  @@unique([schoolId, periodNumber])
  @@index([schoolId])
  @@map("periods")
}

model TimetableSlot {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dayOfWeek      DayOfWeek
  periodId       String
  period         Period       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId      String?
  teacher        Teacher?     @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  roomNumber     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([sectionId, academicYearId, dayOfWeek, periodId])
  @@index([schoolId, academicYearId, dayOfWeek])
  @@index([teacherId, academicYearId, dayOfWeek, periodId])
  @@map("timetable_slots")
}

model TeacherAllocation {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  sectionId      String
  section        Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  isClassTeacher Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([schoolId, academicYearId])
  @@index([teacherId, academicYearId])
  @@index([sectionId, academicYearId])
  @@map("teacher_allocations")
}

// ============================================================================
// Communication, Announcements & Web Push Notifications (Milestone 7)
// ============================================================================

enum AnnouncementPriority {
  NORMAL
  URGENT
  EMERGENCY
}

enum AnnouncementAudience {
  ALL_SCHOOL
  SPECIFIC_CLASSES
  TEACHERS_ONLY
  PARENTS_ONLY
  STAFF_ONLY
}

enum NotificationType {
  ANNOUNCEMENT
  ATTENDANCE_ALERT
  TIMETABLE_UPDATE
  FEE_REMINDER
  SYSTEM_ALERT
}

model Announcement {
  id             String               @id @default(uuid())
  schoolId       String
  school         School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title          String
  content        String
  priority       AnnouncementPriority @default(NORMAL)
  targetAudience AnnouncementAudience @default(ALL_SCHOOL)
  targetClassIds String[]             @default([])
  authorId       String
  author         User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  isPublished    Boolean              @default(true)
  publishedAt    DateTime             @default(now())
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([schoolId, isPublished, publishedAt])
  @@index([authorId])
  @@map("announcements")
}

model Notification {
  id        String           @id @default(uuid())
  schoolId  String
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType @default(ANNOUNCEMENT)
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([schoolId, userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, userId])
  @@map("push_subscriptions")
}

// ============================================================================
// Academics: Examinations, Assessments, Marks & Grading Scales (Milestone 8)
// ============================================================================

model ExamTerm {
  id             String       @id @default(uuid())
  schoolId       String
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  type           ExamTermType @default(TERM_1)
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  exams Exam[]

  @@unique([schoolId, academicYearId, name])
  @@index([schoolId, academicYearId])
  @@map("exam_terms")
}

model Exam {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  termId    String
  term      ExamTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessments Assessment[]

  @@unique([termId, classId, name])
  @@index([schoolId, termId])
  @@index([classId])
  @@map("exams")
}

model Assessment {
  id           String         @id @default(uuid())
  schoolId     String
  examId       String
  exam         Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  subjectId    String
  subject      Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  type         AssessmentType @default(THEORY)
  maxMarks     Float          @default(100.0)
  passingMarks Float          @default(33.0)
  weightage    Float?
  date         DateTime
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  marksRecords MarksRecord[]

  @@unique([examId, subjectId, type])
  @@index([examId])
  @@index([subjectId])
  @@map("assessments")
}

model MarksRecord {
  id            String     @id @default(uuid())
  schoolId      String
  assessmentId  String
  assessment    Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollmentId  String
  enrollment    Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  marksObtained Float?
  isAbsent      Boolean    @default(false)
  remarks       String?
  enteredById   String?
  enteredBy     User?      @relation(fields: [enteredById], references: [id], onDelete: SetNull)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([assessmentId, enrollmentId])
  @@index([assessmentId])
  @@index([enrollmentId])
  @@index([schoolId])
  @@map("marks_records")
}

model GradingScale {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String   @default("CBSE 9-Point Scale")
  grade         String
  minPercentage Float
  maxPercentage Float
  gradePoint    Float
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, grade])
  @@index([schoolId])
  @@map("grading_scales")
}


