# ==============================================================================
# Vidya — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.prod for production deployments with ./manage.sh start prod
# ==============================================================================

# Server Runtime
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
HTTP_PORT=80

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=vidya
POSTGRES_PASSWORD=replace_with_strong_production_password_2026
POSTGRES_DB=vidya_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# Valkey Cache (Redis-compatible)
VALKEY_PORT=6379
VALKEY_URL=redis://valkey:6379

# Authentication & Security (MUST be replaced in production with cryptographically random keys >= 32 chars)
JWT_ACCESS_SECRET=vidya_production_super_secret_jwt_access_key_2026_min_32
JWT_REFRESH_SECRET=vidya_production_super_secret_jwt_refresh_key_2026_min_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=vidya_production_cookie_signing_secret_key_minimum_32_chars

# Frontend & CORS
CORS_ORIGIN=http://localhost

# Logging
LOG_LEVEL=info

