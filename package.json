{
  "name": "vidya",
  "version": "0.1.0",
  "private": true,
  "description": "Vidya — The Open School Operating System",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "docker:up": "./manage.sh start dev",
    "docker:down": "./manage.sh down dev",
    "docker:logs": "./manage.sh logs dev -f",
    "docker:status": "./manage.sh status",
    "docker:prod:up": "./manage.sh start prod",
    "docker:prod:down": "./manage.sh down prod",
    "docker:prod:logs": "./manage.sh logs prod -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "vue-demi@0.14.10": true,
    "@prisma/engines@5.22.0": true
  },
  "dependencies": {
    "@prisma/engines": "^5.22.0"
  }
}
