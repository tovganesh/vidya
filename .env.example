# ==============================================================================
# VidyaSetu — Environment Configuration Template
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://vidyasetu:vidyasetu_password@localhost:5432/vidyasetu_db?schema=public
POSTGRES_USER=vidyasetu
POSTGRES_PASSWORD=vidyasetu_password
POSTGRES_DB=vidyasetu_db
POSTGRES_PORT=5432

# Authentication & Security
JWT_ACCESS_SECRET=vidyasetu-development-jwt-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=vidyasetu-development-jwt-refresh-secret-minimum-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=vidyasetu-cookie-signing-secret-key-development

# Frontend & CORS
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1

# Optional Valkey Cache (Redis-compatible)
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Logging
LOG_LEVEL=info
